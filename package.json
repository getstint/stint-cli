{
  "name": "getstint",
  "version": "0.1.1",
  "description": "Track your coding time and AI agents with Stint: one command connects Claude Code, Codex, Gemini CLI, OpenCode and your editors.",
  "keywords": [
    "stint",
    "time-tracking",
    "wakatime",
    "wakatime-alternative",
    "claude-code",
    "codex",
    "gemini-cli",
    "opencode",
    "ai-agents",
    "cli",
    "developer-tools"
  ],
  "homepage": "https://getstint.dev",
  "bugs": {
    "url": "https://github.com/getstint/stint-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getstint/stint-cli.git"
  },
  "license": "MIT",
  "author": "Stint <hello@getstint.dev> (https://getstint.dev)",
  "type": "module",
  "bin": {
    "stint": "dist/stint.mjs",
    "getstint": "dist/stint.mjs"
  },
  "files": [
    "dist/stint.mjs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run typecheck && bun test && bun run build",
    "prepublishOnly": "bun run check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/bun": "^1.2.22",
    "@types/node": "^22.15.0",
    "picocolors": "^1.1.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
